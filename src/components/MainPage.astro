---
<section class="welcome">
  <h1>Radiology guidelines</h1>
  <p>Open access guidelines and reference material for radiologists.</p>
</section>

<div class="main-grid">
  <section class="panel locations">
    <h2>Locations and modalities</h2>
    <div class="anatomy-map-wrap">
      <svg class="image-map anatomy-map" viewBox="0 0 337 1540" role="img" aria-labelledby="anatomy-map-title anatomy-map-desc" preserveAspectRatio="xMidYMin meet">
        <title id="anatomy-map-title">Interactive Radlines anatomy menu</title>
        <desc id="anatomy-map-desc">Select a labeled body region or imaging modality to open its Radlines page.</desc>
        <image href="/media/Anatomy_image_for_main_menu.png" x="0" y="0" width="337" height="1540" />
        {hotspots.map((h) => (
          <a href={h.href} aria-label={h.label}>
            <title>{h.label}</title>
            <rect class="hotspot" x={h.x} y={h.y} width={h.w} height={h.h} rx="1" />
          </a>
        ))}
      </svg>
      <p class="map-help">Click any labeled area of the image.</p>
    </div>
  </section>

  <div class="side-column">
    <section class="panel">
      <h2>Emergencies</h2>
      <ul class="main-links">
        <li><a href="/Trauma">Trauma</a></li>
        <li><a href="/Stroke">Stroke</a></li>
        <li><a href="/Contrast_medium_reaction">Contrast medium reaction</a></li>
      </ul>
    </section>

    <section class="panel">
      <h2><a href="/Radlines:About">About Radlines</a></h2>
      <p>Radlines is an international, collaborative, non-profit, ad-free and open access collection of guidelines in radiology. It is created by doctors, providing quick access to the most relevant information.</p>
      <p>Further information: <a href="/Radlines:About">About Radlines</a></p>
      <p class="article-count">283 articles in the original Radlines snapshot.</p>
    </section>

    <section class="panel">
      <h2>Case of the month</h2>
      <figure class="case-figure">
        <a href="https://commons.wikimedia.org/wiki/File:3D_CT_of_thorax,_annotated.jpg" target="_blank" rel="noopener">
          <img src="https://commons.wikimedia.org/wiki/Special:Redirect/file/3D_CT_of_thorax,_annotated.jpg?width=640" width="320" alt="3D CT of thorax, annotated" loading="lazy" referrerpolicy="no-referrer" />
        </a>
        <figcaption>Volume rendering of a <a href="/CT">CT scan</a> of the thorax.</figcaption>
      </figure>
    </section>

    <section class="panel abdomen-panel">
      <h2><a href="/Abdomen_and_pelvis">Abdomen and pelvis</a></h2>
      <div class="abdomen-map-wrap">
        <svg class="image-map abdomen-map" viewBox="0 0 330 659" role="img" aria-labelledby="abdomen-map-title abdomen-map-desc" preserveAspectRatio="xMidYMin meet">
          <title id="abdomen-map-title">Interactive abdomen and pelvis menu</title>
          <desc id="abdomen-map-desc">Select an abdominal or pelvic organ, region, or imaging modality to open its Radlines page.</desc>
          <image href="/media/Abdomen_and_pelvis_for_menu.png" x="0" y="0" width="330" height="659" />
          {abdomenHotspots.map((h) => (
            <a href={h.href} aria-label={h.label}>
              <title>{h.label}</title>
              <rect class="hotspot" x={h.x} y={h.y} width={h.w} height={h.h} rx="1" />
            </a>
          ))}
        </svg>
        <p class="map-help">Click any labeled area of the image.</p>
      </div>
      <ul class="main-links after-map">
        <li><a href="/Abdominal_wall">Abdominal wall</a></li>
      </ul>
      <p><a href="/Abdomen_and_pelvis">More abdomen and pelvis</a></p>
    </section>

    <section class="panel">
      <h2>Location-unspecific diseases</h2>
      <ul class="main-links">
        <li><a href="/Tumors">Tumors</a></li>
        <li><a href="/Abscess">Abscess</a></li>
        <li><a href="/Lipoma">Lipoma</a></li>
      </ul>
    </section>
  </div>
</div>

<style>
.welcome{text-align:center;padding:24px 12px 18px}.welcome h1{border:0;margin:0 0 6px;font-size:1.9rem}.welcome p{margin:0 auto;color:#52606d}
.main-grid{display:grid;grid-template-columns:minmax(355px,430px) minmax(330px,1fr);gap:22px;align-items:start;margin:18px auto;max-width:980px}.side-column{display:flex;flex-direction:column;gap:18px}
.panel{border:1px solid #d9e0e8;border-radius:8px;background:#fff;padding:18px}.panel h2{font-size:1.1rem;margin:0 0 14px;padding:8px 10px;border:1px solid #a3b0bf;background:#cedff2;color:#000;border-radius:3px}.panel h2 a{text-decoration:none;color:inherit}.panel p{line-height:1.45}.main-links{margin:.25rem 0 .5rem;padding-left:1.35rem}.main-links li{margin:.25rem 0}.article-count{font-size:.85rem;color:#64748b}.case-figure{margin:0}.case-figure img{display:block;width:min(100%,320px);height:auto}.case-figure figcaption{margin-top:.55rem;line-height:1.4}
.locations{text-align:center}.anatomy-map-wrap{width:100%;max-width:380px;margin:0 auto}.image-map{display:block;width:100%;height:auto;margin:0 auto}.hotspot{fill:transparent;stroke:transparent;stroke-width:1;pointer-events:all}.hotspot:hover,.hotspot:focus{fill:rgba(37,99,166,.13);stroke:#2563a6}.map-help{margin:.65rem auto 0;color:#64748b;font-size:.84rem;text-align:center}.abdomen-map-wrap{width:100%;max-width:330px;margin:0 auto}.after-map{margin-top:1rem}
@media(max-width:800px){.main-grid{grid-template-columns:1fr;max-width:430px}.panel{padding:14px}.anatomy-map-wrap{max-width:337px}.abdomen-map-wrap{max-width:330px}}
</style>
